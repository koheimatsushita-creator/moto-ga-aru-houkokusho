{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moto-ga-aru-houkokusho",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 実行モードの回数の上限（lib/limits.ts）。手元の npm run dev では使わない
  // 同じ接続元から1分3回。namespace_id は同じアカウントの中で重ならない番号にする（公開の時に確かめる）
  "ratelimits": [
    { "name": "JUDGE_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  // 全体で1日30回の回数を日付ごとに持つ。
  // id は仮の値。公開の時に本体が `wrangler kv namespace create JUDGE_COUNTS` で作ったIDに差し替える
  "kv_namespaces": [
    { "binding": "JUDGE_COUNTS", "id": "REPLACE_WITH_KV_NAMESPACE_ID_AT_PUBLISH" }
  ],
  "observability": { "enabled": true }
}
